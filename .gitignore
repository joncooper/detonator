# Python build artifacts (tripwire sdist)
phase0/tripwire-src/dist/
phase0/tripwire-src/build/
phase0/tripwire-src/*.egg-info/
__pycache__/
*.pyc

# Detonation outputs — never commit behavior logs / samples
results/
*.result.json
tripwire-result.json

# Raw sinkhole captures & trace dumps hold exfiltrated data (private keys, creds,
# host recon) grabbed during detonation — never commit them. Keep human-written
# writeups (*.md) and sanitized verdict summaries (*.jsonl) only.
*.pcap
docs/eval/**/*.log
docs/eval/**/traces/

# Go build output + proxy cache
/detonator
/dscore
/.detonator-cache/

# Local env
.env
*.pem
